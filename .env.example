# =============================================================================
# GiveMeJobPlease V1 Configuration
# Copy to .env and fill in the required values.
# =============================================================================

# Required: Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Required: Comma-separated Telegram numeric user IDs allowed to use this bot.
# Find your ID by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Required: Base64-encoded 32-byte master key for AES-256-GCM encryption at rest
# Generate one cleanly with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_URLSAFE_BASE64_KEY

# Optional: SQLite database path (Docker mounts ./data -> /app/data)
DATABASE_URL=sqlite+aiosqlite:///data/give_me_job_please.db

# Optional: Directory for rotating JSON error logs
LOG_DIR=data/logs
LOG_LEVEL=INFO

# Optional: Mode A (Zero-Key Local Fallback) ONNX multilingual embedding model
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_PATH=data/model_cache

# Optional: Mode B (OpenRouter OAuth PKCE) default model & batching
# You can switch models anytime via Telegram using /model
DEFAULT_OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BATCH_SIZE=15
OPENROUTER_APP_TITLE=GiveMeJobPlease
OPENROUTER_APP_URL=https://github.com/unusedusername01/GiveMeJobPlease

# Optional: Items per page in Telegram /digest and /browse messages
DIGEST_PAGE_SIZE=5
